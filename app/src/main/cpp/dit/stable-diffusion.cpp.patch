diff --git a/include/stable-diffusion.h b/include/stable-diffusion.h
--- a/include/stable-diffusion.h
+++ b/include/stable-diffusion.h
@@
 typedef struct sd_ctx_t sd_ctx_t;
+
+typedef struct {
+    const char* prompt;
+    sd_image_t reference_image;
+} sd_condition_params_t;
+
+typedef struct {
+    float* hidden_states;
+    float* attention_mask;
+    int sequence_length;
+    int hidden_size;
+} sd_condition_output_t;
+
+// Runs only the loaded text/VLM conditioner. This is intentionally separate
+// from generation so external diffusion runtimes can reuse Qwen3-VL.
+SD_API bool sd_encode_condition(sd_ctx_t* sd_ctx,
+                                const sd_condition_params_t* params,
+                                sd_condition_output_t* output);
+SD_API void sd_free_condition(sd_condition_output_t* output);
diff --git a/src/stable-diffusion.cpp b/src/stable-diffusion.cpp
--- a/src/stable-diffusion.cpp
+++ b/src/stable-diffusion.cpp
@@
 #include "pipeline/request.h"
+#include "conditioning/conditioner.hpp"
@@
 void free_sd_ctx(sd_ctx_t* sd_ctx) {
@@
 }
+
+SD_API bool sd_encode_condition(sd_ctx_t* sd_ctx,
+                                const sd_condition_params_t* params,
+                                sd_condition_output_t* output) {
+    if (output != nullptr) {
+        *output = {};
+    }
+    if (sd_ctx == nullptr || sd_ctx->sd == nullptr || params == nullptr ||
+        output == nullptr || sd_ctx->sd->cond_stage_model == nullptr) {
+        return false;
+    }
+
+    StableDiffusionGGML::ExecutionScope execution(*sd_ctx->sd);
+    if (!execution.ready) {
+        return false;
+    }
+
+    std::vector<sd::Tensor<float>> refs;
+    if (params->reference_image.data != nullptr &&
+        params->reference_image.width > 0 && params->reference_image.height > 0 &&
+        params->reference_image.channel >= 3) {
+        const int64_t width = params->reference_image.width;
+        const int64_t height = params->reference_image.height;
+        const int channels = params->reference_image.channel;
+        sd::Tensor<float> image({width, height, 3, 1});
+        const int64_t pixels = width * height;
+        for (int64_t p = 0; p < pixels; ++p) {
+            for (int ch = 0; ch < 3; ++ch) {
+                image[p + ch * pixels] =
+                    params->reference_image.data[p * channels + ch] / 255.0f;
+            }
+        }
+        refs.emplace_back(std::move(image));
+    }
+
+    ConditionerParams cp;
+    cp.text = params->prompt == nullptr ? "" : params->prompt;
+    cp.ref_images = refs.empty() ? nullptr : &refs;
+    // DreamLite's reference VLM path uses a 256px conditioning image.
+    cp.ref_image_params.vlm_resize_mode = RefImageResizeMode::LONGEST_SIDE;
+    cp.ref_image_params.vlm_min_size = 256;
+    cp.ref_image_params.vlm_max_size = 256;
+
+    SDCondition condition =
+        sd_ctx->sd->cond_stage_model->get_learned_condition(sd_ctx->sd->n_threads, cp);
+    if (condition.c_crossattn.empty() || condition.c_crossattn.dim() < 2) {
+        return false;
+    }
+
+    const int hidden = static_cast<int>(condition.c_crossattn.shape()[0]);
+    const int sequence = static_cast<int>(condition.c_crossattn.shape()[1]);
+    const size_t count = static_cast<size_t>(hidden) * sequence;
+    output->hidden_states = static_cast<float*>(malloc(count * sizeof(float)));
+    output->attention_mask =
+        static_cast<float*>(malloc(static_cast<size_t>(sequence) * sizeof(float)));
+    if (output->hidden_states == nullptr || output->attention_mask == nullptr) {
+        sd_free_condition(output);
+        return false;
+    }
+    memcpy(output->hidden_states, condition.c_crossattn.values().data(),
+           count * sizeof(float));
+    std::fill(output->attention_mask, output->attention_mask + sequence, 1.0f);
+    output->sequence_length = sequence;
+    output->hidden_size = hidden;
+    return true;
+}
+
+SD_API void sd_free_condition(sd_condition_output_t* output) {
+    if (output == nullptr) return;
+    free(output->hidden_states);
+    free(output->attention_mask);
+    *output = {};
+}

