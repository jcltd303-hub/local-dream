@@
 sd_ctx_t* new_sd_ctx(const sd_ctx_params_t* sd_ctx_params) {
@@
 }
+
+SD_API sd_ctx_t* new_sd_condition_ctx(const sd_ctx_params_t* params) {
+    sd_ctx_t* ctx = static_cast<sd_ctx_t*>(malloc(sizeof(sd_ctx_t)));
+    if (!ctx) return nullptr;
+    ctx->sd = new StableDiffusionGGML();
+    if (!ctx->sd || !ctx->sd->init_conditioner_only(params)) {
+        delete ctx->sd;
+        free(ctx);
+        return nullptr;
+    }
+    return ctx;
+}
